FROM node:22-alpine AS build

ARG VITE_API_BASE_URL=http://localhost:8000
ARG VITE_AUTH_MODE=fake
# Opcional — sin valor por defecto: si no se pasa, initSentry() no
# inicializa Sentry en el bundle resultante (Fase 10.6, ver
# src/shared/sentry.ts).
ARG VITE_SENTRY_DSN=
# Variable NUESTRA (a diferencia de RAILWAY_GIT_COMMIT_SHA más abajo): la
# pipeline de despliegue debe pasarla explícitamente por servicio ("staging"
# para el servicio de Railway de staging, "production" para el de
# production) — `vite build` siempre produce MODE=production en ambos, así
# que sin esta variable Sentry etiquetaría erróneamente los eventos de
# staging como production (ver src/shared/sentry.ts). Sin valor por
# defecto: si no se pasa, cae a MODE (development/production).
ARG VITE_SENTRY_ENVIRONMENT=
# RAILWAY_GIT_COMMIT_SHA: variable inyectada por Railway (no nuestra),
# solo poblada en deploys disparados desde GitHub — sin valor por defecto,
# initSentry() la trata como "sin release" si llega vacía. Si tras un
# deploy real el campo `release` aparece vacío en Sentry, es señal de que
# en este proyecto la variable no llega hasta el build de este Dockerfile
# — revisarlo entonces, no asumir que funciona solo porque compila.
ARG RAILWAY_GIT_COMMIT_SHA=
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_AUTH_MODE=${VITE_AUTH_MODE} \
    VITE_SENTRY_DSN=${VITE_SENTRY_DSN} \
    VITE_SENTRY_ENVIRONMENT=${VITE_SENTRY_ENVIRONMENT} \
    VITE_SENTRY_RELEASE=${RAILWAY_GIT_COMMIT_SHA}

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf.template /etc/nginx/templates/default.conf.template

ENV PORT=8080
EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
