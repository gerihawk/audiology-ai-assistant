server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Cabeceras de seguridad HTTP (Fase 10.5). Sin Content-Security-Policy:
    # exige conocer a fondo qué scripts/estilos inline usa el build de
    # Vite — una CSP mal calibrada rompe la SPA entera, queda fuera de
    # esta ronda.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location / {
        try_files $uri /index.html;
    }
}
