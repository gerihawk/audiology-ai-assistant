# Entornos y secretos
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*

# Node / frontend
node_modules/
dist/
.vite/
npm-debug.log*
*.tsbuildinfo
/frontend/vite.config.js
/frontend/vite.config.d.ts

# Datos locales (audio ficticio, volúmenes montados fuera de Docker)
backend/data/
backend/storage/
*.sqlite3

# Benchmark de transcripción (Fase 5 / 5.1): nunca audios ni resultados
# reales en el repo, ver docs/transcription-benchmark.md.
# Estructura legacy (superada por benchmark/dataset/, ver Fase 5.1):
backend/benchmark/audio/*
!backend/benchmark/audio/.gitkeep
!backend/benchmark/audio/README.md
# Golden dataset: solo el audio de cada caso queda fuera del repo —
# reference.json/metadata.json/*.example/README.md sí se versionan.
backend/benchmark/dataset/*/audio.*
backend/benchmark/results/*
!backend/benchmark/results/.gitkeep

# Benchmark de generación LLM (Fase 6.2): input.json/reference.json/
# metadata.json de benchmark/generation_dataset/ SÍ se versionan (nunca
# audio, sin binarios que excluir) — solo los resultados quedan fuera del
# repo, ver docs/generation-benchmark.md.
backend/benchmark/generation_results/*
!backend/benchmark/generation_results/.gitkeep

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
