      }
    },
    {
      "concept": "hearing_aid_use",
      "expected": "negated",
      "patterns": {
        "negated": ["nunca ha utilizado audífonos", "no usa audífonos", "no ha usado audífonos"],
        "affirmed": ["usa audífonos", "utiliza audífonos"]
      }
    }
  ],
  "laterality_cases": [
