# Copia este fichero como .env y ajusta los valores. Nunca commitees .env.
# Los valores de ejemplo de aquí son válidos SOLO para desarrollo local.

# --- Entorno ---
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL (usado por el servicio "db" de docker-compose y por el backend) ---
POSTGRES_USER=audiology_dev
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_DB=audiology_ai_assistant
# En docker-compose, POSTGRES_HOST debe ser el nombre del servicio ("db").
# Para ejecutar el backend fuera de Docker, usa "localhost".
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
BACKEND_PORT=8000
# Orígenes permitidos por CORS, separados por comas. Nunca uses "*" fuera de
# development. En production, define aquí el dominio real del frontend.
BACKEND_CORS_ORIGINS=http://localhost:5173

# --- Frontend (Vite) ---
FRONTEND_PORT=5173
# URL base que el frontend usa para llamar a la API del backend.
VITE_API_BASE_URL=http://localhost:8000

# --- Transcripción (Fase 5) ---
# mock | assemblyai | deepgram — resuelto por Dependency Injection, ver
# docs/transcription-benchmark.md. "mock" no requiere API key.
TRANSCRIPTION_PROVIDER=mock
# Obligatoria solo si TRANSCRIPTION_PROVIDER=assemblyai. Nunca commitees un
# valor real aquí — este fichero SÍ se versiona; la clave real va solo en
# tu .env local (ignorado por git).
ASSEMBLYAI_API_KEY=CHANGE_ME_LOCAL_ONLY
ASSEMBLYAI_LANGUAGE_CODE=es

# --- Deepgram (Fase 5.3) ---
# Obligatoria solo si TRANSCRIPTION_PROVIDER=deepgram. Nunca commitees un
# valor real aquí — la clave real va solo en tu .env local.
DEEPGRAM_API_KEY=CHANGE_ME_LOCAL_ONLY
# Endpoint EU por defecto (residencia de datos UE) — ver
# docs/transcription-benchmark.md §Endpoint europeo. Cambia a
# https://api.deepgram.com si necesitas el endpoint genérico.
DEEPGRAM_BASE_URL=https://api.eu.deepgram.com
DEEPGRAM_LANGUAGE_CODE=es
DEEPGRAM_MODEL=nova-3

# Future providers
OPENAI_API_KEY=
SPEECHMATICS_API_KEY=
AZURE_SPEECH_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
