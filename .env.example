# Copia este fichero como .env y ajusta los valores. Nunca commitees .env.
# Los valores de ejemplo de aquí son válidos SOLO para desarrollo local.

# --- Entorno ---
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL (usado por el servicio "db" de docker-compose y por el backend) ---
POSTGRES_USER=audiology_dev
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_DB=audiology_ai_assistant
# En docker-compose, POSTGRES_HOST debe ser el nombre del servicio ("db").
# Para ejecutar el backend fuera de Docker, usa "localhost".
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
BACKEND_PORT=8000
# Orígenes permitidos por CORS, separados por comas. Nunca uses "*" fuera de
# development. En production, define aquí el dominio real del frontend.
BACKEND_CORS_ORIGINS=http://localhost:5173

# --- Autenticación (Fase 9, hito 9.1) ---
# fake | real — "fake" (por defecto) mantiene el comportamiento actual
# (cabecera X-Dev-User-Id); "real" activa JWT Bearer vía POST
# /api/v1/auth/login. Obligatorio "real" en production, ver
# Settings._validate_production_safety en core/config.py.
AUTH_MODE=fake
# Clave de firma del JWT (HS256). Nunca commitees un valor real aquí —
# la clave real va solo en tu .env local. Se rechaza en production si
# coincide con este placeholder (ver core/config.py).
JWT_SECRET_KEY=CHANGE_ME_LOCAL_ONLY

# --- Frontend (Vite) ---
FRONTEND_PORT=5173
# URL base que el frontend usa para llamar a la API del backend.
VITE_API_BASE_URL=http://localhost:8000
# fake | real — espejo del AUTH_MODE del backend (Fase 9, hito 9.2). El
# frontend no detecta el modo dinámicamente contra el backend: se
# configura igual que el backend, vía entorno. "fake" (por defecto) no
# cambia nada del comportamiento actual (selector de usuario ficticio,
# X-Dev-User-Id). "real" muestra la pantalla de login (JWT Bearer).
VITE_AUTH_MODE=fake
# Site key público de Cloudflare Turnstile (Fase 12, hito 12.4 ampliado,
# decisión del 2026-09-18) — sin valor, SignupPage no renderiza ningún
# widget y envía un token vacío (coherente con TURNSTILE_PROVIDER=mock del
# backend, ver más abajo). Público por diseño (va en el HTML servido al
# navegador): a diferencia de TURNSTILE_SECRET_KEY, no es un secreto.
VITE_TURNSTILE_SITE_KEY=

# --- Transcripción (Fase 5) ---
# mock | assemblyai | deepgram — resuelto por Dependency Injection, ver
# docs/transcription-benchmark.md. "mock" no requiere API key.
TRANSCRIPTION_PROVIDER=mock
# Obligatoria solo si TRANSCRIPTION_PROVIDER=assemblyai. Nunca commitees un
# valor real aquí — este fichero SÍ se versiona; la clave real va solo en
# tu .env local (ignorado por git).
ASSEMBLYAI_API_KEY=CHANGE_ME_LOCAL_ONLY
ASSEMBLYAI_LANGUAGE_CODE=es

# --- Deepgram (Fase 5.3) ---
# Obligatoria solo si TRANSCRIPTION_PROVIDER=deepgram. Nunca commitees un
# valor real aquí — la clave real va solo en tu .env local.
DEEPGRAM_API_KEY=CHANGE_ME_LOCAL_ONLY
# Endpoint EU por defecto (residencia de datos UE) — ver
# docs/transcription-benchmark.md §Endpoint europeo. Cambia a
# https://api.deepgram.com si necesitas el endpoint genérico.
DEEPGRAM_BASE_URL=https://api.eu.deepgram.com
DEEPGRAM_LANGUAGE_CODE=es
DEEPGRAM_MODEL=nova-3

# Future providers
OPENAI_API_KEY=
SPEECHMATICS_API_KEY=
AZURE_SPEECH_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Onboarding self-service multi-clínica (Fase 12, hito 12.1) ---
# URL pública del frontend — usada para construir el enlace que el usuario
# recibe por email (verificación de registro, recuperación de contraseña).
FRONTEND_BASE_URL=http://localhost:5173
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_HOURS=2

# --- Email transaccional (Fase 12, hito 12.1) ---
# mock | brevo — "mock" (por defecto, ConsoleEmailSender) no requiere
# credenciales y nunca envía tráfico real. "brevo": DPA autoservicio
# archivado en docs/legal/brevo-dpa-2026-09-15.pdf.
EMAIL_PROVIDER=mock
EMAIL_FROM_ADDRESS=no-reply@audiology-assistant.dev
EMAIL_FROM_NAME=Audiology AI Assistant
# Obligatoria solo si EMAIL_PROVIDER=brevo. Nunca commitees un valor real
# aquí — la clave real va solo en tu .env local (ignorado por git).
BREVO_API_KEY=CHANGE_ME_LOCAL_ONLY
BREVO_BASE_URL=https://api.brevo.com

# --- Anti-abuso en el alta pública (Fase 12, hito 12.4 ampliado, decisión
# del 2026-09-18 — ver docs/fase-12-rfc.md §6) ---
# mock | cloudflare — "mock" (por defecto, MockTurnstileVerifier) siempre
# aprueba y no requiere credenciales. "cloudflare": Cloudflare Turnstile,
# el site key público va en el frontend (ver .env.example del frontend).
TURNSTILE_PROVIDER=mock
# Obligatoria solo si TURNSTILE_PROVIDER=cloudflare. Nunca commitees un
# valor real aquí — la clave real va solo en tu .env local (ignorado por
# git).
TURNSTILE_SECRET_KEY=CHANGE_ME_LOCAL_ONLY
TURNSTILE_BASE_URL=https://challenges.cloudflare.com

# --- Limpieza de clínicas no verificadas (Fase 12, hito 12.4) ---
# Días de gracia desde el alta (POST /clinics/signup) antes de que una
# clínica sin ningún usuario activo se considere "fantasma" y sea
# purgada — ver app/onboarding/cleanup_service.py.
UNVERIFIED_CLINIC_TTL_DAYS=7
# Autentica al cron externo de POST /api/v1/onboarding/system-cleanup
# (cabecera X-Onboarding-Cleanup-Cron-Secret) — mismo criterio que
# RETENTION_CRON_SECRET/JWT_SECRET_KEY. Nunca commitees un valor real
# aquí — la clave real va solo en tu .env local (ignorado por git).
ONBOARDING_CLEANUP_CRON_SECRET=CHANGE_ME_LOCAL_ONLY

# --- Cifrado de campos a nivel de aplicación (Fase 12) ---
# Cifra a nivel de aplicación (AES-256-GCM) las columnas clínicas más
# sensibles (patients.display_name/birth_year,
# ai_artifact_versions.content, ai_generation_runs.rendered_*/
# raw_response) — ver app/core/field_encryption.py y
# docs/privacy-and-security.md §4. A diferencia de JWT_SECRET_KEY de
# arriba, este valor NO puede quedarse en un simple placeholder de texto:
# la app cifra/descifra de verdad en cada lectura/escritura de esas
# columnas, incluso en development/test — un placeholder no-base64 rompe
# la app en el primer uso. La clave de abajo es una clave AES-256 real,
# generada solo para desarrollo local (no protege ningún dato real, por
# eso puede vivir en un fichero de ejemplo commiteado): NUNCA la
# reutilices en staging/production, donde `_validate_production_safety`
# la rechazaría igualmente por no ser secreta. Formato:
# "key_id:base64key,key_id:base64key,..." (una entrada por clave viva,
# ver el runbook de rotación en app/core/field_encryption_cli.py).
FIELD_ENCRYPTION_KEYS=1:HEFvJucNIlytjAspyvBhWs58nGaFik96u9LFGlo6wMA=
# key_id (de FIELD_ENCRYPTION_KEYS de arriba) usado para CIFRAR valores
# nuevos; las demás claves presentes solo sirven para poder seguir
# descifrando datos antiguos tras una rotación.
FIELD_ENCRYPTION_ACTIVE_KEY_ID=1

# --- Facturación / Stripe (Fase 13, hito 13.1) — ver docs/fase-13-rfc.md ---
# mock | stripe — "mock" (por defecto, MockPaymentGateway) nunca llama a
# Stripe de verdad (CLAUDE.md §6). "stripe": SDK oficial, modo test hasta
# el hito 13.4 (paso a producción).
PAYMENT_GATEWAY=mock
# Obligatorias solo si PAYMENT_GATEWAY=stripe. Nunca commitees un valor
# real aquí — las claves reales van solo en tu .env local (ignorado por
# git).
STRIPE_SECRET_KEY=CHANGE_ME_LOCAL_ONLY
STRIPE_WEBHOOK_SECRET=CHANGE_ME_LOCAL_ONLY
# Un Price de Stripe (modo suscripción) por nivel — ver la tabla de
# precios cerrada en docs/fase-13-rfc.md §3.2. Vacíos hasta crear cada
# Price en el dashboard de Stripe (modo test primero).
STRIPE_PRICE_ID_BASICO=
STRIPE_PRICE_ID_PROFESIONAL=
STRIPE_PRICE_ID_CLINICA_GRANDE=
STRIPE_PRICE_ID_CADENA_EMPRESA=

# --- Facturación / Stripe (Fase 13, hito 13.2) — resto de ciclo de vida,
# overage y reconciliación diaria, ver docs/fase-13-rfc.md §3.2/§5/§6 ---
# Price MEDIDO (metered) de overage por nivel — objeto DISTINTO del Meter
# de abajo (el Price se usa al crear la Checkout Session, el Meter al
# reportar uso). Cadena/Empresa no tiene overage definido en este hito
# (ver app/billing/domain/plans.py), por eso no aparece aquí.
STRIPE_METERED_PRICE_ID_BASICO=
STRIPE_METERED_PRICE_ID_PROFESIONAL=
STRIPE_METERED_PRICE_ID_CLINICA_GRANDE=
# `event_name` del Stripe Billing Meter de cada nivel — el Meter debe
# crearse en Stripe con fórmula de agregación "last", no "sum" (ver
# docstring de PaymentGateway.report_overage_usage): con "sum" el overage
# reportado cada día se acumularía sobre sí mismo.
STRIPE_METER_EVENT_NAME_BASICO=
STRIPE_METER_EVENT_NAME_PROFESIONAL=
STRIPE_METER_EVENT_NAME_CLINICA_GRANDE=
# Autentica al cron externo diario de POST /api/v1/billing/reconcile
# (cabecera X-Billing-Reconcile-Cron-Secret) — mismo criterio que
# RETENTION_CRON_SECRET/ONBOARDING_CLEANUP_CRON_SECRET. Nunca commitees un
# valor real aquí — la clave real va solo en tu .env local.
BILLING_RECONCILE_CRON_SECRET=CHANGE_ME_LOCAL_ONLY
# `estimated_cost_usd` (coste de LLM/transcripción, Fase 6) está en USD,
# pero la Price MEDIDA de Stripe está en EUR (mismo criterio que el resto
# del catálogo) — tipo de cambio ESTÁTICO fijado a mano, sin integración
# con ninguna API de divisas en este hito. Revísalo y actualízalo
# periódicamente; valor por defecto solo orientativo.
USD_TO_EUR_EXCHANGE_RATE=0.92

# --- Consentimiento de procesamiento IA (Fase 6, hito 6.0) ---
# false en esta fase: todos los proveedores de run_pipeline siguen siendo
# Mock. El hito 6.3 (proveedor LLM real) decide su activación.
AI_PROCESSING_CONSENT_ENFORCED=false
AI_PROCESSING_CONSENT_VERSION=1.0

# --- Benchmark de generación LLM (Fase 6.2) — ver docs/generation-benchmark.md ---
# OpenRouter es EXCLUSIVO de benchmark/generation/, nunca del pipeline de
# producción (que sigue usando Mock* hasta el hito 6.3). La app arranca sin
# OPENROUTER_API_KEY; solo `python -m benchmark.generation.cli` la necesita.
# Nunca commitees un valor real aquí — la clave real va solo en tu .env local.
GENERATION_BENCHMARK_ENABLED=false
OPENROUTER_API_KEY=CHANGE_ME_LOCAL_ONLY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
