# Copia este fichero como .env y ajusta los valores. Nunca commitees .env.
# Los valores de ejemplo de aquí son válidos SOLO para desarrollo local.

# --- Entorno ---
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL (usado por el servicio "db" de docker-compose y por el backend) ---
POSTGRES_USER=audiology_dev
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_DB=audiology_ai_assistant
# En docker-compose, POSTGRES_HOST debe ser el nombre del servicio ("db").
# Para ejecutar el backend fuera de Docker, usa "localhost".
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
BACKEND_PORT=8000
# Orígenes permitidos por CORS, separados por comas. Nunca uses "*" fuera de
# development. En production, define aquí el dominio real del frontend.
BACKEND_CORS_ORIGINS=http://localhost:5173

# --- Autenticación (Fase 9, hito 9.1) ---
# fake | real — "fake" (por defecto) mantiene el comportamiento actual
# (cabecera X-Dev-User-Id); "real" activa JWT Bearer vía POST
# /api/v1/auth/login. Obligatorio "real" en production, ver
# Settings._validate_production_safety en core/config.py.
AUTH_MODE=fake
# Clave de firma del JWT (HS256). Nunca commitees un valor real aquí —
# la clave real va solo en tu .env local. Se rechaza en production si
# coincide con este placeholder (ver core/config.py).
JWT_SECRET_KEY=CHANGE_ME_LOCAL_ONLY

# --- Frontend (Vite) ---
FRONTEND_PORT=5173
# URL base que el frontend usa para llamar a la API del backend.
VITE_API_BASE_URL=http://localhost:8000
# fake | real — espejo del AUTH_MODE del backend (Fase 9, hito 9.2). El
# frontend no detecta el modo dinámicamente contra el backend: se
# configura igual que el backend, vía entorno. "fake" (por defecto) no
# cambia nada del comportamiento actual (selector de usuario ficticio,
# X-Dev-User-Id). "real" muestra la pantalla de login (JWT Bearer).
VITE_AUTH_MODE=fake

# --- Transcripción (Fase 5) ---
# mock | assemblyai | deepgram — resuelto por Dependency Injection, ver
# docs/transcription-benchmark.md. "mock" no requiere API key.
TRANSCRIPTION_PROVIDER=mock
# Obligatoria solo si TRANSCRIPTION_PROVIDER=assemblyai. Nunca commitees un
# valor real aquí — este fichero SÍ se versiona; la clave real va solo en
# tu .env local (ignorado por git).
ASSEMBLYAI_API_KEY=CHANGE_ME_LOCAL_ONLY
ASSEMBLYAI_LANGUAGE_CODE=es

# --- Deepgram (Fase 5.3) ---
# Obligatoria solo si TRANSCRIPTION_PROVIDER=deepgram. Nunca commitees un
# valor real aquí — la clave real va solo en tu .env local.
DEEPGRAM_API_KEY=CHANGE_ME_LOCAL_ONLY
# Endpoint EU por defecto (residencia de datos UE) — ver
# docs/transcription-benchmark.md §Endpoint europeo. Cambia a
# https://api.deepgram.com si necesitas el endpoint genérico.
DEEPGRAM_BASE_URL=https://api.eu.deepgram.com
DEEPGRAM_LANGUAGE_CODE=es
DEEPGRAM_MODEL=nova-3

# Future providers
OPENAI_API_KEY=
SPEECHMATICS_API_KEY=
AZURE_SPEECH_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Consentimiento de procesamiento IA (Fase 6, hito 6.0) ---
# false en esta fase: todos los proveedores de run_pipeline siguen siendo
# Mock. El hito 6.3 (proveedor LLM real) decide su activación.
AI_PROCESSING_CONSENT_ENFORCED=false
AI_PROCESSING_CONSENT_VERSION=1.0

# --- Benchmark de generación LLM (Fase 6.2) — ver docs/generation-benchmark.md ---
# OpenRouter es EXCLUSIVO de benchmark/generation/, nunca del pipeline de
# producción (que sigue usando Mock* hasta el hito 6.3). La app arranca sin
# OPENROUTER_API_KEY; solo `python -m benchmark.generation.cli` la necesita.
# Nunca commitees un valor real aquí — la clave real va solo en tu .env local.
GENERATION_BENCHMARK_ENABLED=false
OPENROUTER_API_KEY=CHANGE_ME_LOCAL_ONLY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
